# Скопируйте этот файл в .env и впишите свои значения. Файл .env в git не попадает.

# Сервисный ключ приложения VK (vk.com/apps?act=manage → приложение → Настройки)
VK_TOKEN=
VK_API_VERSION=5.199

# База данных: локально SQLite, при размещении — адрес PostgreSQL
DATABASE_URL=sqlite:///calendar.db

# С каких адресов фронтенд может обращаться к API напрямую, через запятую.
# По умолчанию — сервер разработки Vite: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=

# Папка собранного фронтенда, которую раздаёт API. По умолчанию web/dist
# WEB_DIST_DIR=
